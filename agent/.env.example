# 복사해서 .env.local 로 쓰고, 절대 커밋하지 말 것 (.gitignore 에 있음).
# App Service 에서는 이 파일 대신 App Settings(환경변수)로 같은 키를 넣는다.

ENV=local

# ---- S3 (사내) ----
S3_ENDPOINT=https://s3.internal.example.com
S3_BUCKET=my-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---- 로컬 캐시 ----
# 로컬: ./data/cache  /  App Service: /tmp/cache (컨테이너 재시작 시 사라짐)
CACHE_DIR=./data/cache

# ---- Milvus ----
# 로컬: docker compose -f docker-compose.dev.yml up -d 후 http://localhost:19530
# 클라우드: 사내 Milvus 주소
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=docs
EMBED_DIM=384

# ---- 임베딩 ----
# local  : sentence-transformers 모델을 프로세스 안에서 실행
# http   : 사내 임베딩 API 호출 (EMBED_ENDPOINT 필요)
EMBED_PROVIDER=local
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_ENDPOINT=

# ---- LLM (Anthropic Claude) ----
ANTHROPIC_API_KEY=
# 사내 게이트웨이를 경유한다면 여기에 주소를 넣는다. 비우면 기본 엔드포인트.
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high

# ---- 운영 ----
LOG_LEVEL=INFO
DIAG_TOKEN=            # 비우면 /diag 무인증. 배포 시에는 반드시 값을 넣을 것
GIT_SHA=dev
